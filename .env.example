# Required
ADMIN_PASSWORD=choose-a-long-unique-password
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
TWILIO_AUTH_TOKEN=YOUR_ROTATED_TWILIO_AUTH_TOKEN

# Generated random secrets; use long random values in production
SECRET_KEY=replace-with-a-long-random-secret
MEDIA_SIGNING_SECRET=replace-with-another-long-random-secret

# Optional S3-compatible object storage (recommended on Render Free)
# S3_BUCKET=your-private-bucket
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_ENDPOINT_URL=https://your-object-storage-endpoint
# S3_REGION=auto
# S3_PREFIX=media-voice

MAX_UPLOAD_MB=25
MEDIA_LINK_TTL_SECONDS=21600
DATA_DIR=/tmp/media-voice-data
